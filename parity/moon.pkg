pkgtype(kind: "executable")
import {
  "fathom/sql/api" @api,
  "fathom/sql/binding" @binding,
  "fathom/sql/completion" @completion,
  "fathom/sql/source" @source,
  "fathom/sql/dialect" @dialect,
  "fathom/sql/parser" @parser,
  "fathom/sql/printer" @printer,
  "fathom/sql/syntax" @syntax,
  "fathom/sql/formatter" @formatter,
  "moonbitlang/core/encoding/utf8" @utf8,
}

import {
  "moonbitlang/core/test" @test,
} for "test"

options(
  targets: {
    "run_native.mbt": ["native"],
    "run_js.mbt": ["js"],
    "run_wasm.mbt": ["wasm"],
  },
)
