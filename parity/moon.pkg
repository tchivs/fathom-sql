pkgtype(kind: "executable")

import {
  "fathom/sql/api",
  "fathom/sql/binding",
  "fathom/sql/completion",
  "fathom/sql/source",
  "fathom/sql/dialect",
  "fathom/sql/parser",
  "fathom/sql/printer",
  "fathom/sql/syntax",
  "fathom/sql/formatter",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/test",
} for "test"

options(
  targets: {
    "run_native.mbt": [ "native" ],
    "run_js.mbt": [ "js" ],
    "run_wasm.mbt": [ "wasm" ],
  },
)
