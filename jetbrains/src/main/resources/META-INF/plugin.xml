<idea-plugin>
    <id>fathom.doris.sql</id>
    <name>Doris SQL LSP</name>
    <version>0.1.0</version>
    <vendor email="maintainers@fathom.dev" url="https://github.com/apache/doris">Fathom</vendor>
    <idea-version since-build="252" until-build="253.*"/>
    <description><![CDATA[
        Doris SQL language support backed by the repository's local doris-lsp Native server.
        LSP transport and protocol integration are provided by LSP4IJ.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="doris" name="Doris SQL" factoryClass="fathom.jetbrains.doris.DorisLanguageServerFactory">
            <description><![CDATA[Local doris-lsp Native server over stdio.]]></description>
        </server>
        <fileNamePatternMapping patterns="*.sql" serverId="doris" languageId="doris"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools" instance="fathom.jetbrains.doris.DorisSettingsConfigurable"/>
    </extensions>
</idea-plugin>
