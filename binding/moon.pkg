pkgtype(kind: "foreign_library")
import {
  "fathom/sql/api" @api,
  "fathom/sql/source" @source,
  "fathom/sql/completion" @completion,
  "fathom/sql/analyzer" @analyzer,
  "moonbitlang/core/debug" @debug,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/encoding/utf8" @utf8,
}

options(
  link: {
    "js": {
      "format": "esm",
      "exports": [
        "fathom_parse_v1",
        "fathom_format_v1",
        "fathom_complete_v1",
        "fathom_lint_v1",
        "fathom_fingerprint_v1",
        "fathom_lineage_v1",
        "fathom_dialect_v1",
        "fathom_capabilities_v1",
      ],
    },
    "wasm": {
      "exports": [
        "fathom_parse_v1",
        "fathom_format_v1",
        "fathom_complete_v1",
        "fathom_lint_v1",
        "fathom_fingerprint_v1",
        "fathom_lineage_v1",
        "fathom_dialect_v1",
        "fathom_capabilities_v1",
      ],
    },
  },
)
